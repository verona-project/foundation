(testing:test concatenation-preserves-unicode-bytes-and-lengths
  (let
    ((text string:string (string:empty (support:backend)))
     (input (array u8 10) (array-of 65 195 169 226 130 172 240 159 152 128))
     (joined string:string (string:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view (& (index input 0)) 10))
               ((ok) true)
               (_ false)))
           (testing:check (match (string:concat text text (& joined)) ((ok) true) (_ false)))
           (testing:check (== (string:scalar-length joined) u64-8))
           (testing:check (== (string:byte-length joined) u64-20))
           (testing:check
             (match (string:substring joined 4 4)
               ((tuple true view) (data:equal view (string:bytes text)))
               (_ false))))))
      (do (string:destroy (& text)) (string:destroy (& joined)) observed))))

(testing:test failed-concatenation-preserves-destination
  (let
    ((text string:string (string:empty (support:backend)))
     (joined string:string (string:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view "long text" 9)) ((ok) true) (_ false)))
           (testing:check
             (match (string:from-utf8 (& joined) (data:view "old" 3)) ((ok) true) (_ false)))
           (do
             (support:limit 0)
             (testing:check
               (match (string:concat text text (& joined))
                 ((allocation-error reason) true)
                 (_ false))))
           (testing:check (data:equal (string:bytes joined) (data:view "old" 3))))))
      (do (string:destroy (& text)) (string:destroy (& joined)) observed))))

(testing:test long-string-substrings-check-every-position
  (let
    ((text string:string (string:empty (support:backend)))
     (source data:data (data:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (data:resize (& source) 2048) ((ok) true) (_ false)))
           (do
             (fill-x (data:bytes source) 2048)
             (testing:check
               (match (string:from-utf8 (& text) (data:borrow source)) ((ok) true) (_ false))))
           (verify-substrings text 0 (testing:empty)))))
      (do (data:destroy (& source)) (string:destroy (& text)) observed))))

(base:function fill-emoji ((bytes (pointer u8)) (count u64)) unit
  (match (== count u64-0)
    (true unit)
    (false
      (match (== count u64-1)
        (true
          (do
            (store (deref bytes) 240)
            (store (deref (pointer-offset bytes 1)) 159)
            (store (deref (pointer-offset bytes 2)) 152)
            (store (deref (pointer-offset bytes 3)) 128)
            unit))
        (false
          (let ((half u64 (/ count u64-2)))
            (do
              (fill-emoji bytes half)
              (fill-emoji (pointer-offset bytes (* half u64-4)) (- count half)))))))))

(base:function large-unicode () data:data
  (let ((value data:data (data:empty (support:backend))))
    (do
      (match (data:resize (& value) 16385)
        ((ok)
         (do
           (store (deref (data:bytes value)) 65)
           (fill-emoji (pointer-offset (data:bytes value) 1) 4096)))
        (_ unit))
      value)))

(base:function release-unicode ((value data:data)) unit
  (data:destroy (& value)))

(testing:test large-unicode-validation-counts-scalars
  (testing:with-fixture (value data:data (large-unicode) release-unicode)
    (testing:check (== (data:length value) u64-16385))
    (testing:check
      (match (string:validate (data:borrow value)) ((tuple true count) (== count u64-4097)) (_ false)))))

(testing:test large-unicode-validation-rejects-bad-tail
  (testing:with-fixture (value data:data (large-unicode) release-unicode)
    (match (== (data:length value) u64-16385)
      (false (testing:fail))
      (true
        (do
          (store (deref (pointer-offset (data:bytes value) 16384)) 255)
          (testing:check
            (match (string:validate (data:borrow value)) ((tuple false _) true) (_ false))))))))

