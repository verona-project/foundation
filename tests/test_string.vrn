(testing:test invalid-replacement-preserves-original
  (let ((text string:string (string:empty (support:backend))) (bad (array u8 2) (array-of 192 128)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view "original" 8)) ((ok) true) (_ false)))
           (testing:check
             (match (string:from-utf8 (& text) (data:view (& (index bad 0)) 2))
               ((invalid-input) true)
               (_ false)))
           (testing:check (data:equal (string:bytes text) (data:view "original" 8)))
           (testing:check (== (string:scalar-length text) u64-8)))))
      (do (string:destroy (& text)) observed))))

(testing:test allocation-failure-preserves-original
  (let ((text string:string (string:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view "old" 3)) ((ok) true) (_ false)))
           (do
             (support:limit 0)
             (testing:check
               (match (string:from-utf8 (& text) (data:view "long replacement" 16))
                 ((allocation-error reason) true)
                 (_ false))))
           (testing:check (data:equal (string:bytes text) (data:view "old" 3)))
           (testing:check (== (string:scalar-length text) u64-3)))))
      (do (string:destroy (& text)) observed))))

(testing:test copy-is-independent
  (let
    ((text string:string (string:empty (support:backend)))
     (copy string:string (string:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view "hello" 5)) ((ok) true) (_ false)))
           (testing:check (match (string:copy text (& copy)) ((ok) true) (_ false)))
           (testing:check
             (match (string:from-utf8 (& text) (data:view "other" 5)) ((ok) true) (_ false)))
           (testing:check (data:equal (string:bytes copy) (data:view "hello" 5))))))
      (do (string:destroy (& text)) (string:destroy (& copy)) observed))))

