(import base)
(import testing)
(import allocator)
(import error)
(import system_allocator :as system)
(import support)
(import string)
(import data)

(base:constant u64-2048 u64 2048)
(base:constant u64-1 u64 1)
(base:constant u64-0 u64 0)
(base:constant u64-10 u64 10)
(base:constant u64-4 u64 4)
(base:constant u64-8 u64 8)
(base:constant u64-3 u64 3)
(base:constant u64-2 u64 2)
(base:constant u64-20 u64 20)
(base:constant u64-16385 u64 16385)
(base:constant u64-4097 u64 4097)

(base:function validate-count ((p (pointer u8)) (length u64) (count u64)) testing:result
  (testing:check
    (match (string:validate (data:view p length))
      ((tuple true actual) (== actual count))
      (_ false))))

(base:function reject ((p (pointer u8)) (length u64)) testing:result
  (testing:check (match (string:validate (data:view p length)) ((tuple false _) true) (_ false))))

(base:function verify-substrings ((text string:string) (i u64) (acc testing:result)) testing:result
  (match (== i u64-2048)
    (true acc)
    (false
      (verify-substrings
        text
        (+ i u64-1)
        (testing:checks
          acc
          (testing:check
            (match (string:substring text i 1)
              ((tuple true view) (data:equal view (data:view "x" 1)))
              (_ false))))))))

(base:function fill-x ((p (pointer u8)) (count u64)) unit
  (match (== count u64-0)
    (true unit)
    (false (do (store (deref p) 120) (fill-x (pointer-offset p 1) (- count u64-1))))))

(testing:test validate-empty
  (validate-count "" 0 0))

(testing:test validate-ascii-nul
  (let ((input (array u8 1) (array-of 0))) (validate-count (& (index input 0)) 1 1)))

(testing:test validate-ascii-maximum
  (let ((maximum char (base:maxBound)))
    (let ((input (array u8 1) (array-of maximum))) (validate-count (& (index input 0)) 1 1))))

(testing:test validate-two-byte-minimum
  (let ((input (array u8 2) (array-of 194 128))) (validate-count (& (index input 0)) 2 1)))

(testing:test validate-two-byte-maximum
