(testing:test empty-string-lengths
  (let ((text string:string (string:empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (== (string:byte-length text) u64-0))
           (testing:check (== (string:scalar-length text) u64-0)))))
      (do (string:destroy (& text)) observed))))

(testing:test substring-first
  (let
    ((text string:string (string:empty (support:backend)))
     (input (array u8 10) (array-of 65 195 169 226 130 172 240 159 152 128)))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check
             (match (string:from-utf8 (& text) (data:view (& (index input 0)) 10))
               ((ok) true)
               (_ false)))
           (testing:check
             (match (string:substring text 0 1)
               ((tuple true view)
                (data:equal view (data:view (pointer-offset (& (index input 0)) 0) 1)))
               (_ false))))))
      (do (string:destroy (& text)) observed))))

