(testing:test reinsertion-reuses-tombstones
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 4)
           (testing:check (map-remove (& table) 1))
           (do
             (support:limit 0)
             (testing:check (match (map-insert (& table) 10 55) ((ok) true) (_ false))))
           (testing:check (== (map-count table) u64-4))
           (testing:check (map-get table 10 (& out)))
           (testing:check (== out u64-55)))))
      (do (map-destroy (& table)) observed))))

(testing:test all-tombstones-lookup-terminates-and-can-reinsert
  (let ((table spread-table (spread-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (tombstones (& table) 0)
           (testing:check (match (spread-get table 99 (& out)) (true false) (false true)))
           (testing:check (== out u64-999))
           (do
             (support:limit 0)
             (testing:check (match (spread-insert (& table) 99 42) ((ok) true) (_ false))))
           (testing:check (spread-get table 99 (& out)))
           (testing:check (== out u64-42)))))
      (do (spread-destroy (& table)) observed))))

(testing:test clear-removes-entries-and-reuses-allocation
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 512)
           (do (map-clear (& table)) (testing:check (== (map-count table) u64-0)))
           (testing:check (match (map-contains table 100) (true false) (false true)))
           (do (support:limit 0) (populate (& table) 0 512))
           (verify table 0 512))))
      (do (map-destroy (& table)) observed))))

