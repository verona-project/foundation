(import base)
(import testing)
(import allocator)
(import error)
(import system_allocator :as system)
(import support)
(import array)
(import dictionary)

(base:constant u64-17 u64 17)
(base:constant u64-3 u64 3)
(base:constant u64-1 u64 1)
(base:constant u64-64 u64 64)
(base:constant u64-0 u64 0)
(base:constant u64-777777 u64 777777)
(base:constant u64-4096 u64 4096)
(base:constant u64-48271 u64 48271)
(base:constant u64-8 u64 8)
(base:constant u64-512 u64 512)
(base:constant u64-999 u64 999)
(base:constant u64-73 u64 73)
(base:constant u64-2 u64 2)
(base:constant u64-4 u64 4)
(base:constant u64-1234 u64 1234)
(base:constant u64-9999 u64 9999)
(base:constant u64-55 u64 55)
(base:constant u64-42 u64 42)

; Deliberately start at the last bucket to force wraparound collision chains.
(base:function hash ((key u64)) u64
  (base:maxBound))

(base:function equal ((left u64) (right u64)) bool
  (== left right))

(base:function identity-hash ((key u64)) u64
  key)

(dictionary:define map u64 u64 hash equal 32 8)

(dictionary:define spread u64 u64 identity-hash equal 32 8)

(base:function populate ((owner (pointer map-table)) (i u64) (count u64)) testing:result
  (match (== i count)
    (true (testing:empty))
    (false
      (match (map-insert owner i (+ (* i u64-17) u64-3))
        ((ok) (populate owner (+ i u64-1) count))
        (_ (testing:fail))))))

(base:function verify ((table map-table) (i u64) (count u64)) testing:result
  (match (== i count)
    (true (testing:empty))
    (false
      (let ((out u64 0))
        (testing:checks
          (testing:check (map-get table i (& out)))
          (testing:check (== out (+ (* i u64-17) u64-3)))
          (verify table (+ i u64-1) count))))))

(base:function update-all ((owner (pointer map-table)) (i u64) (count u64)) testing:result
  (match (== i count)
    (true (testing:empty))
    (false
      (match (map-insert owner i (+ (* i u64-17) u64-3))
        ((ok) (update-all owner (+ i u64-1) count))
        (_ (testing:fail))))))

(base:function check-model ((table map-table) (model (pointer u64)) (key u64)) testing:result
  (match (== key u64-64)
    (true (testing:empty))
    (false
      (let ((expected u64 (deref (pointer-offset model key))) (out u64 777777))
        (testing:checks
          (match (== expected u64-0)
            (true
              (testing:checks
                (testing:check (match (map-get table key (& out)) (false true) (true false)))
                (testing:check (== out u64-777777))))
            (false
              (testing:checks
                (testing:check (map-get table key (& out)))
                (testing:check (== out expected)))))
          (check-model table model (+ key u64-1)))))))

(base:function count-model ((model (pointer u64)) (key u64) (count u64)) u64
  (match (== key u64-64)
    (true count)
    (false
      (count-model
        model
        (+ key u64-1)
        (+ count (match (== (deref (pointer-offset model key)) u64-0) (true u64-0) (false u64-1)))))))

; Direct-indexed oracle is independent of hashing, probing, rehashing and tombstones.
(base:function mixed-operations
  ((owner (pointer map-table)) (model (pointer u64)) (step u64) (seed u64) (acc testing:result))
  testing:result
  (match (== step u64-4096)
    (true acc)
    (false
      (let
        ((next u64 (support:remainder (+ (* seed u64-48271) u64-17) 2147483647))
         (key u64 (support:remainder next 64))
         (action u64 (support:remainder (/ next u64-64) 3))
         (operation
           testing:result
           (match (== action u64-0)
             (true
               (let
                 ((was-present
                    bool
                    (match (== (deref (pointer-offset model key)) u64-0) (true false) (false true))))
                 (testing:checks
                   (testing:check (base-equal (map-remove owner key) was-present))
                   (do (store (deref (pointer-offset model key)) 0) (testing:pass)))))
             (false
               (match (map-insert owner key (+ step u64-1))
                 ((ok)
                  (do (store (deref (pointer-offset model key)) (+ step u64-1)) (testing:pass)))
                 (_ (testing:fail)))))))
        (mixed-operations
          owner
          model
          (+ step u64-1)
          next
          (testing:checks
            acc
            operation
            (check-model (deref owner) model 0)
            (testing:check (== (map-count (deref owner)) (count-model model 0 0)))))))))

(base:function base-equal (for (t) ((base:equality t))) ((x t) (y t)) bool
  (= x y))

(base:function tombstones ((owner (pointer spread-table)) (i u64)) testing:result
  (match (== i u64-8)
    (true (testing:empty))
    (false
      (match (spread-insert owner i i)
        ((ok)
         (testing:checks (testing:check (spread-remove owner i)) (tombstones owner (+ i u64-1))))
        (_ (testing:fail))))))

(base:variable seen (pointer u8) "")

(base:function seen-at ((i u64)) (pointer u64)
  (pointer-offset (cast (pointer u64) (cast (pointer void) seen)) i))

(base:variable visit-errors u64 0)

(base:function reset-seen ((i u64)) unit
  (match (== i u64-512)
    (true unit)
    (false (do (store (deref (seen-at i)) 0) (reset-seen (+ i u64-1))))))

(base:function visit ((key u64) (value u64)) unit
  (match (< key u64-512)
    (false (do (assign visit-errors (+ visit-errors u64-1)) unit))
    (true
      (do
        (store (deref (seen-at key)) (+ (deref (seen-at key)) u64-1))
        (match (== value (+ (* key u64-17) u64-3))
          (true unit)
          (false (do (assign visit-errors (+ visit-errors u64-1)) unit)))))))

(base:function verify-seen ((i u64)) testing:result
  (match (== i u64-512)
    (true (testing:empty))
    (false (testing:checks (testing:check (== (deref (seen-at i)) u64-1)) (verify-seen (+ i u64-1))))))

(testing:test empty-has-no-entries-or-allocation
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (== (map-count table) u64-0))
           (testing:check (== (map-capacity table) u64-0))
           (testing:check (match (map-contains table 0) (true false) (false true)))
           (testing:check (match (map-remove (& table) 0) (true false) (false true)))
           (testing:check (== (support:attempts) u64-0)))))
      (do (map-destroy (& table)) observed))))

(testing:test absent-get-does-not-change-output
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (map-get table 42 (& out)) (true false) (false true)))
           (testing:check (== out u64-999)))))
      (do (map-destroy (& table)) observed))))

(testing:test single-entry-get-and-remove
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (map-insert (& table) 42 73) ((ok) true) (_ false)))
           (testing:check (map-get table 42 (& out)))
           (testing:check (== out u64-73))
           (testing:check (map-remove (& table) 42))
           (testing:check (match (map-contains table 42) (true false) (false true)))
           (testing:check (== (map-count table) u64-0)))))
      (do (map-destroy (& table)) observed))))

(testing:test duplicate-update-does-not-increase-count
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (map-insert (& table) 42 1) ((ok) true) (_ false)))
           (testing:check (match (map-insert (& table) 42 2) ((ok) true) (_ false)))
           (testing:check (== (map-count table) u64-1))
           (testing:check (map-get table 42 (& out)))
           (testing:check (== out u64-2)))))
      (do (map-destroy (& table)) observed))))

(testing:test hundreds-of-collisions-survive-multiple-rehashes
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 512)
           (verify table 0 512)
           (testing:check (== (map-count table) u64-512)))))
      (do (map-destroy (& table)) observed))))

(testing:test update-at-growth-threshold-needs-no-allocation
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 4)
           (do
             (support:limit 0)
             (testing:check (match (map-insert (& table) 2 1234) ((ok) true) (_ false))))
           (testing:check (== (map-count table) u64-4))
           (testing:check (map-get table 2 (& out)))
           (testing:check (== out u64-1234))
           (testing:check (== (support:attempts) u64-1)))))
      (do (map-destroy (& table)) observed))))

(testing:test remove-collision-chain-head
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 4)
           (testing:check (map-remove (& table) 0))
           (testing:check (match (map-contains table 0) (true false) (false true)))
           (testing:check (map-get table 1 (& out)))
           (testing:check (map-get table 2 (& out)))
           (testing:check (map-get table 3 (& out)))
           (testing:check (== (map-count table) u64-3)))))
      (do (map-destroy (& table)) observed))))

