(testing:test repeated-destroy-and-recreation
  (let ((table map-table (map-empty (support:backend))) (out u64 999))
    (let
      ((observed
         testing:result
         (testing:checks
           (populate (& table) 0 64)
           (do
             (map-destroy (& table))
             (map-destroy (& table))
             (testing:check (== (support:outstanding) u64-0)))
           (populate (& table) 0 64)
           (verify table 0 64))))
      (do (map-destroy (& table)) observed))))

