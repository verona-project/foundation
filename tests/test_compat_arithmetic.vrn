(import base)
(import testing)

; Default operators infer literal types from their concrete operand.
(testing:test direct-unsigned-operators
  (let ((value u64 42))
    (testing:checks
      (testing:check (= (+ value 1) 43))
      (testing:check (= (- value 1) 41))
      (testing:check (= (* value 2) 84))
      (testing:check (= (/ value 2) 21))
      (testing:check (< value 43))
      (testing:check (<= value 42))
      (testing:check (> value 41))
      (testing:check (>= value 42)))))

(testing:test direct-signed-operators
  (let ((value i64 -42))
    (testing:checks
      (testing:check (= (+ value 1) -41))
      (testing:check (= (- value 1) -43))
      (testing:check (< value -41))
      (testing:check (> value -43)))))

(export direct-unsigned-operators direct-signed-operators)
