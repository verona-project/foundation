(testing:test extreme-numeric-members
  (let ((items values-table (values-empty (support:backend))))
    (let
      ((observed
         testing:result
         (testing:checks
           (testing:check (match (values-add (& items) 0) ((ok) true) (_ false)))
           (testing:check (match (values-add (& items) (base:maxBound)) ((ok) true) (_ false)))
           (testing:check (values-contains items 0))
           (testing:check (values-contains items (base:maxBound)))
           (testing:check (== (values-count items) u64-2)))))
      (do (values-destroy (& items)) observed))))

