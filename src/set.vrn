(import base)
(import dictionary)

; Sets specialize the dictionary with a boolean payload and share its hash table.
;; Generate a concrete set API backed by Dictionary's boolean payload.
(base:macro define (prefix element hash equal size alignment)
  `((dictionary:define ,prefix ,element bool ,hash ,equal ,size ,alignment)
    (base:function ,(symbol-concat prefix "-add")
      ((owner (pointer ,(symbol-concat prefix "-table"))) (value ,element)) error:status
      (,(symbol-concat prefix "-insert") owner value true))))

(export define)
