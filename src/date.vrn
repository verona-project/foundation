(import base)

(base:type instant (product (seconds i64)))

(base:type duration (product (seconds i64)))

(base:type result (sum (at instant) (overflow) (clock-error)))

(base:type duration-result (sum (elapsed duration) (overflow)))

; time_t is signed 64-bit on supported Darwin/Linux targets.
(base:external-function system-time "time" ((pointer i64)) i64)

(base:function now () result
  (let ((output i64 0) (value i64 (system-time (& output))))
    (match (== value -1) (true (clock-error)) (false (at (instant value))))))

(base:function before ((left instant) (right instant)) bool
  (< (field left seconds) (field right seconds)))

(base:function add-seconds ((x i64) (y i64)) result
  (let ((minimum i64 (base:minBound)) (maximum i64 (base:maxBound)))
    (match (> y 0)
      (true
        (match (> x (- maximum y))
          (true (overflow))
          (false (at (instant (+ x y))))))
      (false
        (match (< x (- minimum y))
          (true (overflow))
          (false (at (instant (+ x y)))))))))
(base:function add ((value instant) (delta duration)) result
  (add-seconds (field value seconds) (field delta seconds)))

(base:function subtract-seconds ((x i64) (y i64)) result
  (let ((minimum i64 (base:minBound)) (maximum i64 (base:maxBound)))
    (match (> y 0)
      (true
        (match (< x (+ minimum y))
          (true (overflow))
          (false (at (instant (- x y))))))
      (false
        (match (> x (+ maximum y))
          (true (overflow))
          (false (at (instant (- x y)))))))))

(base:function subtract ((value instant) (delta duration)) result
  (subtract-seconds (field value seconds) (field delta seconds)))

(base:function between ((start instant) (end instant)) duration-result
  (match (subtract-seconds (field end seconds) (field start seconds))
    ((at value) (elapsed (duration (field value seconds))))
    ((overflow) (overflow))
    ((clock-error) (overflow))))

(export instant duration result duration-result now before add subtract between)
