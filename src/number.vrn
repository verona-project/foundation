(import base)
(import allocator :as a)
(import data :as d)
(import error :as e)

(base:constant u64-0 u64 0)
(base:constant u64-48 u64 48)
(base:constant u64-57 u64 57)
(base:constant u64-1 u64 1)
(base:constant u64-10 u64 10)

; Primitive numbers remain unboxed. Results distinguish malformed text from overflow.
(base:type result (sum (value u64) (invalid) (overflow)))

(base:type signed-result (sum (signed i64) (overflow)))

(base:function parse-at ((p (pointer u8)) (count u64) (acc u64)) result
  (match (== count u64-0)
    (true (value acc))
    (false
      (let ((digit u64 (base:convert (deref p))))
        (match (< digit u64-48)
          (true (invalid))
          (false
            (match (> digit u64-57)
              (true (invalid))
              (false
                (match (a:checked-multiply-size acc 10)
                  ((tuple false _) (overflow))
                  ((tuple valid product)
                   (match (a:checked-add-size product (- digit u64-48))
                     ((tuple false _) (overflow))
                     ((tuple valid sum) (parse-at (pointer-offset p 1) (- count u64-1) sum)))))))))))))

(base:function parse-u64 ((source d:view)) result
  (match (== (field source length) u64-0)
    (true (invalid))
    (false (parse-at (field source bytes) (field source length) 0))))

(base:function to-i64 ((number u64)) signed-result
  (let ((signed-limit i64 (base:maxBound)))
    (match (> number (let ((converted u64 (base:convert signed-limit))) converted))
      (true (overflow))
      (false (signed (base:convert number))))))

(base:function format-digits ((number u64) (owner (pointer d:data))) e:status
  (match (>= number u64-10)
    (true
      (match (format-digits (/ number u64-10) owner)
        ((ok)
         (let ((digit u8 (base:convert (+ u64-48 (- number (* (/ number u64-10) u64-10))))))
           (d:append owner digit)))
        (reason reason)))
    (false (let ((digit u8 (base:convert (+ u64-48 number)))) (d:append owner digit)))))

(base:function format-u64 ((number u64) (owner (pointer d:data))) e:status
  ; Reserve all 20 possible decimal digits before changing the destination.
  (match (d:resize owner 20)
    ((ok) (match (d:resize owner 0) ((ok) (format-digits number owner)) (reason reason)))
    (reason reason)))

(export result signed-result parse-u64 to-i64 format-u64)
