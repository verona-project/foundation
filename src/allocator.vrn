(import base)

(base:constant u64-0 u64 0)
(base:constant u64-1 u64 1)
(base:constant u64-2 u64 2)

(base:type error (sum (invalid-layout) (overflow) (out-of-memory)))

(base:type result (sum (allocated (pointer u8)) (failed error)))

(base:type backend
  (product
    (context (pointer void))
    (acquire (pointer (function ((pointer void) u64 u64) result)))
    (release (pointer (function ((pointer void) (pointer u8) u64 u64) unit)))))

(base:function valid-alignment ((a u64)) bool
  (match (== a u64-0)
    (true false)
    (false
      (match (== a u64-1)
        (true true)
        (false
          (match (== (* (/ a u64-2) u64-2) a) (true (valid-alignment (/ a u64-2))) (false false)))))))

(base:function allocate ((b backend) (size u64) (alignment u64)) result
  (match (valid-alignment alignment)
    (false (failed (invalid-layout)))
    (true
      (let ((f (pointer (function ((pointer void) u64 u64) result)) (field b acquire)))
        (f (field b context) size alignment)))))

(base:function deallocate ((b backend) (p (pointer u8)) (size u64) (alignment u64)) unit
  (let ((f (pointer (function ((pointer void) (pointer u8) u64 u64) unit)) (field b release)))
    (f (field b context) p size alignment)))

(base:function copy-bytes ((to (pointer u8)) (from (pointer u8)) (n u64)) unit
  (match (== n u64-0)
    (true unit)
    (false
      (match (== n u64-1)
        (true (do (store (deref to) (deref from)) unit))
        (false
          (let ((half u64 (/ n u64-2)))
            (do
              (copy-bytes to from half)
              (copy-bytes (pointer-offset to half) (pointer-offset from half) (- n half)))))))))

(base:function success ((p (pointer u8))) result
  (allocated p))

(base:function failure ((e error)) result
  (failed e))

(base:function resize ((b backend) (old (pointer u8)) (old-size u64) (new-size u64) (alignment u64))
  result
  (match (allocate b new-size alignment)
    ((failed e) (failed e))
    ((allocated p)
     (do
       (copy-bytes p old (match (< old-size new-size) (true old-size) (false new-size)))
       (deallocate b old old-size alignment)
       (success p)))))

; Checked size arithmetic returns (tuple success value); overflow returns (false, 0).
(base:function checked-add-size ((a u64) (b u64)) (tuple bool u64)
  (match (> b (- (let ((bound u64 (base:maxBound))) bound) a))
    (true (tuple false 0))
    (false (tuple true (+ a b)))))

(base:function checked-multiply-size ((a u64) (b u64)) (tuple bool u64)
  (match (== a u64-0)
    (true (tuple true 0))
    (false
      (match (> b (/ (let ((bound u64 (base:maxBound))) bound) a))
        (true (tuple false 0))
        (false (tuple true (* a b)))))))

(export
  success
  failure
  error
  result
  backend
  valid-alignment
  allocate
  deallocate
  resize
  copy-bytes
  checked-add-size
  checked-multiply-size)
